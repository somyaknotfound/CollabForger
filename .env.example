# MongoDB connection string for local or hosted development.
MONGODB_URI=mongodb://localhost:27017/collabforge

# Redis connection string for caching, queues, or pub/sub.
REDIS_URL=redis://localhost:6379

# Secret used to sign short-lived access tokens.
JWT_ACCESS_SECRET=replace-with-a-strong-secret

# Secret used to sign refresh tokens.
JWT_REFRESH_SECRET=replace-with-a-strong-secret

# API key for OpenRouter (agent-worker's LLM provider — chosen for a free tier
# since no Anthropic API key is available; see CLAUDE.md "AI agent architecture
# -> LLM provider" for the tradeoffs). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=replace-with-your-api-key

# Model ID to use via OpenRouter. Verify it's still in the free catalog before
# relying on it — https://openrouter.ai/api/v1/models, free-tier lineup rotates.
OPENROUTER_MODEL=qwen/qwen3-coder:free

# Public WebSocket endpoint used by the browser client (apps/realtime-server, not yet built).
NEXT_PUBLIC_WS_URL=ws://localhost:3002

# Public HTTP API endpoint used by the browser client.
NEXT_PUBLIC_API_URL=http://localhost:3001
