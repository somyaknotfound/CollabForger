# NEXT_PUBLIC_* vars are exposed to the browser. Keep secrets in non-prefixed vars.

# URL of the REST API server (apps/api-server)
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL of the WebSocket / realtime server, via the Nginx load balancer
# (infra/nginx/nginx.conf) — not a direct realtime-server instance port.
NEXT_PUBLIC_WS_URL=ws://localhost:8080
