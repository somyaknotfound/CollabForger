# HTTP port this service listens on. api-server calls POST /invoke here.
PORT=3004

# MongoDB connection string. Same collection as api-server, but this service
# only ever touches AgentInvocation documents.
MONGODB_URI=mongodb://localhost:27017/collabforge

# WebSocket URL of the realtime-server cluster, THROUGH the Nginx load
# balancer (infra/nginx/nginx.conf) — not a direct instance port. The agent
# joins document rooms the same way any other client does.
REALTIME_WS_URL=ws://localhost:8080

# API key for OpenRouter. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=replace-with-your-api-key

# Model ID to use via OpenRouter. Verify it's still in the free catalog before
# relying on it — https://openrouter.ai/api/v1/models rotates. qwen/qwen3-coder:free
# (CLAUDE.md's original default) is deprecated as of 2026-07 — do not use it.
OPENROUTER_MODEL=poolside/laguna-m.1:free
