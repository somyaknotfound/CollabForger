# HTTP/WS port for the realtime server.
PORT=3002

# Secret used to verify access tokens on WS upgrade. Must match api-server's
# JWT_ACCESS_SECRET exactly — both services verify tokens signed by api-server.
JWT_ACCESS_SECRET=replace-with-a-strong-secret

# MongoDB connection string. Same collection as api-server, but this service
# only ever touches the yjsState/yjsStateVersion/lastEditedAt fields.
MONGODB_URI=mongodb://localhost:27017/collabforge

# Redis connection string — cross-instance sync/awareness fan-out and the
# snapshot write lock. Same Redis instance as api-server.
REDIS_URL=redis://localhost:6379

# Optional — both have code defaults, shown here. How long to wait after the
# last edit before writing a snapshot (debounce), and the longest a
# continuously-active room can go without a save regardless of activity.
SNAPSHOT_DEBOUNCE_MS=2000
SNAPSHOT_MAX_INTERVAL_MS=30000
