# MongoDB connection string for local or hosted development.
MONGODB_URI=mongodb://localhost:27017/collabforge

# Redis connection string for caching, queues, or pub/sub.
REDIS_URL=redis://localhost:6379

# Secret used to sign short-lived access tokens.
JWT_ACCESS_SECRET=replace-with-a-strong-secret

# Secret used to sign refresh tokens.
JWT_REFRESH_SECRET=replace-with-a-strong-secret

# Access token lifetime (short-lived; kept in memory on the client).
JWT_ACCESS_TTL=15m

# Refresh token lifetime (httpOnly cookie; rotated on every use).
JWT_REFRESH_TTL=7d

# Cookie domain for the httpOnly refresh token cookie.
COOKIE_DOMAIN=localhost

# Set to true in production (HTTPS only).
COOKIE_SECURE=false

# Allowed origin for CORS; must be explicit (not '*') since cookies are involved.
CORS_ORIGIN=http://localhost:3000

# HTTP port for the API server.
PORT=3001

# URL of the agent-worker service, invoked when POST /documents/:id/agent is called.
AGENT_WORKER_URL=http://localhost:3004

# Agent invocation rate limits (Redis INCR+EXPIRE, per calendar minute). The
# global cap exists because OpenRouter's free tier is 20 req/min per API key
# for the WHOLE app, not per user — see CLAUDE.md's Redis Role D.
AGENT_RATE_LIMIT_PER_USER=5
AGENT_RATE_LIMIT_GLOBAL=15
